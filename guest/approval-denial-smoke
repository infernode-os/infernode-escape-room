load std
path=(/dis .)

luciuisrv
echo 'activity create Main' > /mnt/ui/ctl
sleep 1
cat /mnt/ui/activity/0/conversation/input > /tmp/approval-denial-answer &
sleep 1
/tmp/infernode-escape-room/deny-approvals &
echo 'role=veltro dtype=dialogue title="Permission required" options=Allow,Deny text="exec test"' > /mnt/ui/activity/0/conversation/ctl
